# Copy this file to .env. Never commit your .env file.
# These are local development defaults, not credentials.
LOG_LEVEL=INFO
LOG_DIR=logs

# Phase 2 capture requests; your webcam may negotiate different values.
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_MIRROR=true
TRACKING_MAX_HANDS=1
# 0 = lighter model; 1 = full model. Both are bundled with MediaPipe.
TRACKING_MODEL_COMPLEXITY=1
TRACKING_DETECTION_CONFIDENCE=0.6
TRACKING_MIN_CONFIDENCE=0.6

# Phase 3 control filtering. X/Y are normalized image coordinates.
# Alpha: (0, 1]; lower values smooth more and respond more slowly.
SMOOTHING_ALPHA=0.35
# XY radius [0, 1] around the previous filtered position; 0 disables it.
SMOOTHING_DEAD_ZONE=0.008
# Confidence in the left/right label, not landmark accuracy: [0, 1].
CONTROL_MIN_HANDEDNESS_CONFIDENCE=0.75
# Seconds without an accepted observation before discarding filter history.
CONTROL_TRACKING_TIMEOUT=0.5

# Phase 4 gesture heuristics; confirmation requires consecutive accepted frames.
GESTURE_DEBOUNCE_FRAMES=5
# Thumb/index tip separation divided by palm size: (0, 1].
GESTURE_PINCH_RATIO=0.3
# Joint angles in degrees: 0 < curled < extended <= 180.
GESTURE_EXTENDED_ANGLE=160
GESTURE_CURLED_ANGLE=105
# Tip/wrist distance relative to finger-base/wrist distance: greater than 1.
GESTURE_REACH_RATIO=1.2

# Phase 5: numerical CV states only. Literal IPv4; default stays on this machine.
UDP_HOST=127.0.0.1
CV_TO_UNITY_PORT=5005
# Port of the Python result receiver (python -m backend.result_receiver); Unity sends finished rounds here.
UNITY_TO_PYTHON_PORT=5006
# Send fresh states at up to this rate (1..120); limited by camera/CV throughput.
UDP_SEND_FPS=30
# Physical hand to control the future cursor; never automatically switches.
CONTROL_HAND=right
# Phase 6 Unity receiver: seconds without an accepted packet before clearing state.
UNITY_RECEIVE_TIMEOUT=0.5

# Reserved for the database phase; Phase 1 does not connect to MongoDB.
# For authenticated MongoDB, put your connection URI only in .env.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=motionplay
